---
import CtaPedir from "./CtaPedir.astro";

const enlaces = [
  { href: "/pizzas/", label: "Pizzas" },
  { href: "/nosotros/", label: "Nosotros" },
  { href: "/delivery/", label: "Delivery" },
  { href: "/como-llegar/", label: "Cómo llegar" },
  { href: "/novedades/", label: "Novedades" },
];

const path = Astro.url.pathname;
---

<nav class="nav" id="site-nav" aria-label="Navegación principal" transition:persist>
  <div class="nav-inner container">
    <a href="/" class="nav-logo" aria-label="Agostina Pizzas, inicio" transition:name="agostina-logo">
      <img src="/assets/logos/logo-compacto-crema.svg" alt="" width="140" height="40" />
      <span class="sr-only">Agostina Pizzas</span>
    </a>
    <ul class="nav-links">
      {
        enlaces.map((e) => (
          <li>
            <a href={e.href} aria-current={path.startsWith(e.href) ? "page" : undefined}>
              {e.label}
            </a>
          </li>
        ))
      }
    </ul>
    <CtaPedir origen="nav" tamano="sm" class="nav-cta" transitionName="agostina-cta" />
    <button class="nav-burger" id="nav-burger" aria-expanded="false" aria-controls="nav-mobile" aria-label="Abrir menú">
      <svg viewBox="0 0 24 24" width="18" height="18" class="icon" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
    </button>
  </div>
</nav>

<div class="nav-mobile" id="nav-mobile" hidden transition:persist>
  <button class="nav-mobile-close" id="nav-mobile-close" aria-label="Cerrar menú">
    <svg viewBox="0 0 24 24" width="22" height="22" class="icon" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
  </button>
  <ul>
    <li><a href="/">Inicio</a></li>
    {enlaces.map((e) => <li><a href={e.href}>{e.label}</a></li>)}
  </ul>
  <CtaPedir origen="nav-mobile" texto="Pedir ahora" />
</div>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: rgba(17, 17, 17, 0.82);
    backdrop-filter: blur(8px);
    transition: background var(--dur) var(--ease);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: 14px 6vw;
  }
  .nav-logo img {
    height: 34px;
    width: auto;
  }
  .nav-links {
    display: none;
    align-items: center;
    gap: 30px;
  }
  .nav-links a {
    font-weight: 600;
    font-size: 12.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-crema);
    opacity: 0.85;
    transition: opacity 0.2s ease, color 0.2s ease;
  }
  .nav-links a:hover,
  .nav-links a[aria-current="page"] {
    opacity: 1;
    color: var(--color-rojo);
  }
  :global(.nav-cta) {
    display: none;
  }
  .nav-burger {
    display: flex;
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
    border: 1.5px solid rgba(245, 239, 230, 0.4);
    color: var(--color-crema);
    border-radius: var(--radius);
  }
  @media (min-width: 860px) {
    .nav-links {
      display: flex;
    }
    :global(.nav-cta) {
      display: inline-flex;
    }
    .nav-burger {
      display: none;
    }
  }

  .nav-mobile {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: var(--color-rojo);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 22px;
    padding: 70px 6vw 40px;
  }
  .nav-mobile[hidden] {
    display: none;
  }
  .nav-mobile ul {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }
  .nav-mobile a {
    font-family: var(--font-display);
    font-size: clamp(28px, 8vw, 42px);
    color: var(--color-crema);
    text-transform: uppercase;
  }
  .nav-mobile-close {
    position: absolute;
    top: 20px;
    right: 6vw;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-pill);
    border: 2px solid var(--color-crema);
    color: var(--color-crema);
    display: flex;
    align-items: center;
    justify-content: center;
  }
</style>

<script>
  const burger = document.getElementById("nav-burger");
  const mobile = document.getElementById("nav-mobile");
  const close = document.getElementById("nav-mobile-close");

  function abrir() {
    mobile?.removeAttribute("hidden");
    burger?.setAttribute("aria-expanded", "true");
    (mobile?.querySelector("a") as HTMLElement | null)?.focus();
  }
  function cerrar() {
    mobile?.setAttribute("hidden", "");
    burger?.setAttribute("aria-expanded", "false");
    burger?.focus();
  }
  burger?.addEventListener("click", abrir);
  close?.addEventListener("click", cerrar);
  mobile?.addEventListener("keydown", (e) => {
    if ((e as KeyboardEvent).key === "Escape") cerrar();
  });
  mobile?.querySelectorAll("a").forEach((a) => a.addEventListener("click", cerrar));

  // El <nav> persiste entre navegaciones (transition:persist), así que su
  // aria-current no se vuelve a calcular solo — se corrige a mano tras cada
  // swap del ClientRouter.
  function marcarActivo() {
    const path = location.pathname;
    document.querySelectorAll<HTMLAnchorElement>(".nav-links a[href]").forEach((a) => {
      const href = a.getAttribute("href") ?? "";
      if (href !== "/" && path.startsWith(href)) a.setAttribute("aria-current", "page");
      else a.removeAttribute("aria-current");
    });
  }
  marcarActivo();
  document.addEventListener("astro:after-swap", () => {
    marcarActivo();
    cerrar();
  });
</script>
