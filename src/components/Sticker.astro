---
/**
 * Stickers de marca Agostina Pizzas: solo lettering troquelado, sin fondo.
 * Cada texto lleva un contorno blanco grueso (= línea de corte) y la sombra la pone el CSS.
 * Una sola fuente para la home y para la hoja de imprenta (/stickers/).
 * Cursiva: Yellowtail (el lettering del logo no se usa como fuente); apoyos en Montserrat.
 */
export type StickerName =
  | "ny" | "masa" | "esperamos" | "lovers-tag" | "buena" | "est" | "pizza-lovers" | "proximamente" | "hermano";

interface Props { name: StickerName; uid?: string; label?: string }
const { name, label } = Astro.props;

const C = { rojo: "#C73A2A", negro: "#111111", oliva: "#5D6A42" };
const SCR = "Yellowtail, cursive";
const SANS = "Montserrat, Helvetica Neue, sans-serif";
const CUT = 14; // contorno blanco (unidades del viewBox)

type Line = { t: string; x: number; y: number; s: number; c: string; sans?: boolean; ls?: number };
type Heart = { x: number; y: number; k: number; c: string };
type Def = { o: [number, number]; box: [number, number, number, number]; rot: number; lines: Line[]; hearts?: Heart[] };

const HEART = "M0 -6 C-4 -14 -16 -14 -16 -4 C-16 4 -6 10 0 16 C6 10 16 4 16 -4 C16 -14 4 -14 0 -6 Z";

// o = lienzo de diseño (su centro es el eje del giro); box = viewBox ajustado al contorno real medido en el navegador
const D: Record<StickerName, Def> = {
  ny: { o: [300, 150], box: [-8, -16, 296, 168], rot: -7, lines: [
    { t: "New York", x: 140, y: 82, s: 72, c: C.rojo },
    { t: "Style", x: 196, y: 126, s: 44, c: C.negro },
  ] },
  masa: { o: [300, 150], box: [8, -11, 279, 163], rot: -5, lines: [
    { t: "Masa hecha", x: 150, y: 70, s: 58, c: C.oliva },
    { t: "a mano", x: 180, y: 120, s: 50, c: C.rojo },
  ] },
  esperamos: { o: [330, 120], box: [-7, -11, 356, 131], rot: -5, lines: [
    { t: "¡Te esperamos!", x: 165, y: 74, s: 58, c: C.rojo },
  ], hearts: [] },
  "lovers-tag": { o: [360, 100], box: [8, -11, 346, 115], rot: -4, lines: [
    { t: "#AgostinaLovers", x: 180, y: 64, s: 52, c: C.rojo },
  ] },
  buena: { o: [300, 160], box: [2, -10, 282, 174], rot: -6, lines: [
    { t: "Buena pizza,", x: 140, y: 68, s: 54, c: C.negro },
    { t: "buena gente", x: 160, y: 124, s: 54, c: C.rojo },
  ] },
  est: { o: [220, 110], box: [2, -16, 221, 127], rot: -8, lines: [
    { t: "Est. 2013", x: 110, y: 68, s: 58, c: C.rojo },
  ] },
  "pizza-lovers": { o: [320, 110], box: [7, -12, 314, 120], rot: -5, lines: [
    { t: "Pizza lovers", x: 182, y: 70, s: 56, c: C.negro },
  ], hearts: [{ x: 44, y: 52, k: 1.35, c: C.rojo }] },
  proximamente: { o: [320, 110], box: [6, -13, 310, 123], rot: -5, lines: [
    { t: "Próximamente", x: 160, y: 68, s: 56, c: C.negro },
  ] },
  hermano: { o: [280, 150], box: [7, -11, 275, 173], rot: -6, lines: [
    { t: "El hermano", x: 132, y: 66, s: 54, c: C.negro },
    { t: "de Agostina", x: 152, y: 122, s: 54, c: C.rojo },
  ] },
};
const d = D[name];
const cx = d.o[0] / 2, cy = d.o[1] / 2;
---

<svg class={`sk sk-${name}`} viewBox={d.box.join(" ")} xmlns="http://www.w3.org/2000/svg" role={label ? "img" : undefined} aria-label={label} aria-hidden={label ? undefined : "true"} data-sticker={name}>
  <g transform={`rotate(${d.rot} ${cx} ${cy})`}>
    {(d.hearts ?? []).map((h) => (
      <path d={HEART} transform={`translate(${h.x} ${h.y}) scale(${h.k})`} fill={h.c} stroke="#fff" stroke-width={CUT / h.k} stroke-linejoin="round" paint-order="stroke" />
    ))}
    {d.lines.map((l) => (
      <text x={l.x} y={l.y} text-anchor="middle" font-family={l.sans ? SANS : SCR} font-weight={l.sans ? 800 : 400} font-size={l.s} letter-spacing={l.ls ?? 0} fill={l.c} stroke="#fff" stroke-width={CUT} stroke-linejoin="round" paint-order="stroke">{l.t}</text>
    ))}
  </g>
</svg>
