---
import Layout from "../../layouts/Layout.astro";
import { MAXIMO, REDES } from "../../data/negocio";
import "../../styles/fonts.css";

// Máximo Panini aún no se lanza: sin precios, nombres de sabores ni fecha.
// Los rótulos describen lo que se ve en las fotos de la sesión del 16 nov 2026.
const sabores = [
  { img: "jamon-gratinado", t: "Jamón y queso gratinado", r: -2 },
  { img: "mechada-pimenton", t: "Mechada con pimentón asado", r: 1.5 },
  { img: "palta-tomate", t: "Palta, tomate y albahaca", r: -1 },
  { img: "prosciutto-rucula", t: "Prosciutto, rúcula y parmesano", r: 2 },
  { img: "pomodoro-pesto", t: "Pomodoro y pesto", r: -1.5 },
  { img: "jamon-glaseado", t: "Jamón glaseado", r: 1 },
];
// Showcase: 8 fotos a pantalla completa; cada una sube y tapa a la anterior con el scroll.
const galeria = [
  { img: "g-01628", a: 0.667 },
  { img: "g-01406", a: 1.5 },
  { img: "g-01551", a: 0.667 },
  { img: "g-01437", a: 1.5 },
  { img: "g-01604", a: 0.667 },
  { img: "g-01567", a: 1.5 },
  { img: "g-01392", a: 0.667 },
  { img: "g-01522", a: 1.5 },
];
const ig = MAXIMO.instagram ?? REDES.instagram.url;
const pronto = MAXIMO.lanzamiento ?? "Próximamente";
---

<Layout
  title={`${MAXIMO.nombre}, il fratello di Agostina`}
  description="Paninis de focaccia, buenos y grandes. Máximo Panini sale de la misma cocina de Agostina Pizzas."
  ogImage="/maximo/hero-caja-panini.webp"
  noIndex={true}
  bareChrome={true}
>
  <header class="mp-hd">
    <a href="/" class="mp-back" aria-label="Ir a Agostina Pizzas">
      <img src="/home/assets/logo-compacto-negro.webp" alt="" width="108" height="56" />
    </a>
    <span class="mp-pill">{pronto}</span>
  </header>

  <div class="mp">
    <section class="mp-hero">
      <div class="mp-copy">
        <p class="mp-kick mp-in" style="--d:0">Il fratello di <a class="ag" href="/">Agostina</a></p>
        <h1 class="mp-logo mp-in mp-wipe" style="--d:1"><img src="/maximo/logo-verde.svg" alt={MAXIMO.nombre} width="1687" height="500" /></h1>
        <p class="mp-h">
          <span class="mp-line"><span class="mp-in" style="--d:2">Paninis de focaccia,</span></span>
          <span class="mp-line"><span class="mp-in mp-acc" style="--d:3">buenos y grandes.</span></span>
        </p>
        <p class="mp-body mp-in" style="--d:4">
          Sale de la misma cocina de <a class="ag" href="/">Agostina</a> y viene a resolverte el almuerzo. Pocos productos, muy bien resueltos, con ingredientes que se notan.
        </p>
        <a class="mp-btn mp-in" style="--d:5" href={ig} target="_blank" rel="noopener" data-track="agostina:maximo_click" data-origen="maximo-hero">
          Entérate primero
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </a>
      </div>
      <figure class="mp-foto mp-drop" data-par>
        <img src="/maximo/hero-caja-panini.webp" alt="Caja de Máximo Panini detrás de un panini de focaccia con rúcula y tomate" width="933" height="1400" fetchpriority="high" />
        <span class="mp-sticker" aria-hidden="true">Recién<br />horneado</span>
      </figure>
    </section>

    <div class="mp-cinta">
      <div class="mp-cinta-in">
        {
          [0, 1, 2, 3].map((k) => (
            <>
              <span>Il fratello di <a href="/" tabindex={k ? -1 : undefined}>Agostina</a></span>
              <span aria-hidden="true">Focaccia de verdad</span>
              <span aria-hidden="true">Misma cocina</span>
              <span aria-hidden="true">{pronto}</span>
            </>
          ))
        }
      </div>
    </div>

    <section class="mp-sabores" aria-labelledby="mp-sab-h">
      <div class="mp-sab-head">
        <h2 id="mp-sab-h" class="mp-h2 reveal">Lo que sale<br />del horno</h2>
        <p class="mp-scr reveal">un martes al almuerzo, o un jueves en la noche</p>
      </div>
      <ul class="mp-grid">
        {sabores.map((s, i) => (
          <li class="mp-card reveal" style={`--r:${s.r}deg; transition-delay:${(i % 3) * 90}ms`}>
            <div class="mp-card-img"><img src={`/maximo/${s.img}.webp`} alt={s.t} width="667" height="1000" loading="lazy" /></div>
            <p><span>{String(i + 1).padStart(2, "0")}</span>{s.t}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="mp-pilares">
      <ol>
        <li class="reveal"><span>01</span><b>Misma cocina</b><p>La de <a class="ag" href="/">Agostina</a>. Mismo horno, misma mano.</p></li>
        <li class="reveal" style="transition-delay:90ms"><span>02</span><b>Focaccia</b><p>Masa alta, aireada y dorada. Crujiente por fuera, suave por dentro.</p></li>
        <li class="reveal" style="transition-delay:180ms"><span>03</span><b>Contundente</b><p>Pensado para que una sola porción te resuelva la comida.</p></li>
      </ol>
    </section>

    <!-- Showcase: la pantalla se queda fija y cada foto sube tapando a la anterior -->
    <section class="mp-show" id="mpShow" aria-label="Galería de Máximo Panini" style={`--n:${galeria.length}`}>
      <div class="mp-show-stick">
        {galeria.map((g, i) => (
          <figure class="mp-show-it" style={`z-index:${i + 1}`}>
            <img src={`/maximo/${g.img}.webp?v=hd`} alt="" loading={i < 2 ? "eager" : "lazy"} decoding="async" />
          </figure>
        ))}
        <div class="mp-show-ui" aria-hidden="true">
          <img class="mp-show-logo" src="/home/assets/maximo-panini-crema.svg" alt="" />
          <p class="mp-show-n"><b id="mpNum">01</b> / {String(galeria.length).padStart(2, "0")}</p>
        </div>
        <div class="mp-reel-bar" aria-hidden="true"><i id="mpBar"></i></div>
      </div>
    </section>
  </div>

  <!-- Footer fijo al fondo: el contenido sube y lo deja a la vista -->
  <footer class="mp-foot">
    <div class="mp-foot-in">
      <img class="mp-foot-logo" src="/home/assets/maximo-panini-crema.svg" alt={MAXIMO.nombre} width="1687" height="500" loading="lazy" />
      <p class="mp-foot-lead">{pronto}. Síguenos para saber cuándo abrimos.</p>
      <a class="mp-btn mp-btn-crema" href={ig} target="_blank" rel="noopener" data-track="agostina:maximo_click" data-origen="maximo-footer">
        Entérate primero
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
      </a>
      <nav class="mp-map" aria-label="Mapa del sitio">
        <div>
          <p>{MAXIMO.nombre}</p>
          <a href="#top" data-top>Arriba</a>
          <a href="#mp-sab-h">Lo que sale del horno</a>
          <a href="#mpReel">Galería</a>
        </div>
        <div>
          <p><a class="ag" href="/">Agostina Pizzas</a></p>
          <a href="/">Inicio</a>
          <a href="/pizzas/">Carta</a>
          <a href="/slice/">Slice</a>
          <a href="/delivery/">Delivery</a>
          <a href="/como-llegar/">Cómo llegar</a>
          <a href="/nosotros/">Nosotros</a>
          <a href="/novedades/">Novedades</a>
        </div>
        <div>
          <p>Redes</p>
          <a href={REDES.instagram.url} target="_blank" rel="noopener">Instagram ↗</a>
          <a href={REDES.tiktok.url} target="_blank" rel="noopener">TikTok ↗</a>
        </div>
      </nav>
      <p class="mp-foot-pie">© 2026 {MAXIMO.nombre} · de la cocina de <a href="/">Agostina Pizzas</a> · <a href="/privacidad/">Privacidad</a></p>
    </div>
  </footer>

  <script>
    import "../../scripts/utm.js";

    let stop: (() => void) | null = null;

    function init() {
      if (stop) stop();
      const reel = document.getElementById("mpShow");
      const bar = document.getElementById("mpBar");
      const num = document.getElementById("mpNum");
      if (!reel || !bar) return;
      const ac = new AbortController();
      const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
      const items = [...reel.querySelectorAll<HTMLElement>(".mp-show-it")];
      const imgs = items.map((el) => el.querySelector("img")!);
      const hero = document.querySelector<HTMLElement>("[data-par]");
      const n = items.length;
      let raf = 0;
      const clamp = (v: number) => Math.min(1, Math.max(0, v));
      const ease = (t: number) => 1 - Math.pow(1 - t, 3);

      // Cada foto ocupa 55svh de scroll; la primera ya está en pantalla.
      function layout() {
        if (reduce) return;
        reel!.style.height = `${Math.round(innerHeight * (1 + (n - 1) * 0.55))}px`;
        frame();
      }

      function frame() {
        raf = 0;
        if (hero) {
          const y = Math.min(scrollY, innerHeight);
          hero.style.transform = `translateY(${y * 0.12}px) rotate(${2 + y * 0.006}deg)`;
        }
        if (reduce) return;
        const r = reel!.getBoundingClientRect();
        const p = clamp(-r.top / (r.height - innerHeight));
        const seg = p * (n - 1);
        items.forEach((el, i) => {
          // t: cuánto entró esta foto; d: cuánto la tapó la siguiente
          const t = i === 0 ? 1 : ease(clamp(seg - (i - 1)));
          const d = i === n - 1 ? 0 : ease(clamp(seg - i));
          el.style.transform = `translate3d(0,${(1 - t) * 100}%,0) scale(${1 - d * 0.08})`;
          el.style.setProperty("--dim", String(d * 0.6));
          imgs[i].style.transform = `translate3d(0,${(t - 1) * 30}%,0) scale(${1.12 - t * 0.12})`;
        });
        num!.textContent = String(Math.min(n, Math.floor(seg + 0.5) + 1)).padStart(2, "0");
        bar!.style.transform = `scaleX(${p})`;
      }
      const onScroll = () => { if (!raf) raf = requestAnimationFrame(frame); };

      addEventListener("scroll", onScroll, { passive: true, signal: ac.signal });
      addEventListener("resize", layout, { signal: ac.signal });
      document.querySelector("[data-top]")?.addEventListener("click", (e) => { e.preventDefault(); scrollTo({ top: 0, behavior: "smooth" }); }, { signal: ac.signal });
      requestAnimationFrame(() => document.documentElement.classList.add("mp-ready"));
      layout();

      stop = () => { ac.abort(); cancelAnimationFrame(raf); document.documentElement.classList.remove("mp-ready"); stop = null; };
    }

    document.addEventListener("astro:page-load", init);
    document.addEventListener("astro:before-swap", () => stop?.());
  </script>
</Layout>

<style>
  :global(body) {
    background: #3e4729;
  }
  .mp,
  .mp-foot {
    --verde: #5d6a42;
    --crema: #f5efe6;
    font-family: "Montserrat", "Helvetica Neue", Arial, sans-serif;
    color: #111;
  }
  /* El contenido va encima y deja un hueco del alto de la pantalla para descubrir el footer */
  .mp {
    position: relative;
    z-index: 1;
    background: var(--crema);
    margin-bottom: 100svh;
    overflow-x: clip;
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.35);
  }
  .mp p {
    margin: 0;
  }
  .mp-h,
  .mp-h2 {
    font-family: "Bebas Neue", "Arial Narrow", sans-serif;
    font-weight: 400;
    text-transform: uppercase;
    line-height: 0.88;
    margin: 0;
  }
  /* Enlaces a Agostina */
  .ag {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--verde);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
    transition: color 0.2s;
  }
  .ag:hover {
    color: var(--verde);
  }

  /* header */
  .mp-hd {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 16px;
    pointer-events: none;
  }
  .mp-hd > * {
    pointer-events: auto;
  }
  .mp-back {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    padding: 4px 10px;
    background: rgba(245, 239, 230, 0.92);
    border-radius: 12px;
  }
  .mp-back img {
    height: 40px;
    width: auto;
  }
  .mp-pill {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 22px;
    border-radius: 999px;
    background: #5d6a42;
    color: #f5efe6;
    border: 2px solid #f5efe6;
    font-family: "Bebas Neue", sans-serif;
    font-size: 22px;
    letter-spacing: 0.04em;
    animation: mp-wobble 3.2s ease-in-out infinite;
  }
  @keyframes mp-wobble {
    0%, 100% { transform: rotate(-3deg); }
    50% { transform: rotate(2deg) translateY(-2px); }
  }

  /* hero */
  .mp-hero {
    display: grid;
    gap: 32px;
    padding: 96px 16px 48px;
    max-width: 1240px;
    margin: 0 auto;
  }
  .mp-kick {
    font-weight: 800;
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--verde);
  }
  .mp-logo {
    margin: 14px 0 22px;
  }
  .mp-logo img {
    width: min(100%, 620px);
    height: auto;
    display: block;
  }
  .mp-h {
    font-size: clamp(46px, 7vw, 92px);
  }
  .mp-line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.04em;
  }
  .mp-line > span {
    display: inline-block;
  }
  .mp-acc {
    color: var(--verde);
  }
  .mp-body {
    margin-top: 20px !important;
    max-width: 46ch;
    font-size: 16px;
    line-height: 1.6;
    color: #3a352e;
  }
  .mp-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 28px;
    min-height: 52px;
    padding: 0 26px;
    background: #111;
    color: #f5efe6;
    font-weight: 800;
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.25s, transform 0.25s, color 0.25s;
  }
  .mp-btn:hover {
    background: var(--verde);
    transform: rotate(-2deg);
  }
  .mp-btn svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
    transition: transform 0.25s;
  }
  .mp-btn:hover svg {
    transform: translateX(4px);
  }
  .mp-foto {
    position: relative;
    margin: 0;
    border: 10px solid #fff;
    box-shadow: 0 24px 48px rgba(17, 17, 17, 0.18);
    transform: rotate(2deg);
    aspect-ratio: 4 / 5;
    will-change: transform;
  }
  .mp-foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .mp-sticker {
    position: absolute;
    left: -18px;
    bottom: 28px;
    padding: 14px 20px 10px;
    background: var(--verde);
    color: #f5efe6;
    font-family: "Bebas Neue", sans-serif;
    font-size: 30px;
    line-height: 0.95;
    text-align: center;
    border: 3px solid #f5efe6;
    border-radius: 12px;
    box-shadow: 0 8px 18px rgba(17, 17, 17, 0.2);
    animation: mp-bob 2.8s ease-in-out infinite;
  }
  @keyframes mp-bob {
    0%, 100% { transform: rotate(-8deg) translateY(0); }
    50% { transform: rotate(-4deg) translateY(-6px); }
  }

  /* entrada del hero (arranca cuando el script marca mp-ready) */
  .mp-in {
    animation: mp-up 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) both paused;
    animation-delay: calc(var(--d) * 110ms);
  }
  .mp-line > .mp-in {
    animation-name: mp-rise;
  }
  .mp-wipe {
    animation-name: mp-wipe;
    animation-duration: 1.1s;
  }
  .mp-drop {
    animation: mp-drop 1.1s cubic-bezier(0.2, 0.9, 0.25, 1.15) 0.35s both paused;
  }
  :global(.mp-ready) .mp-in,
  :global(.mp-ready) .mp-drop {
    animation-play-state: running;
  }
  @keyframes mp-up {
    from { opacity: 0; transform: translateY(24px); }
  }
  @keyframes mp-rise {
    from { transform: translateY(105%); }
  }
  @keyframes mp-wipe {
    from { clip-path: inset(0 100% 0 0); }
    to { clip-path: inset(0 0 0 0); }
  }
  @keyframes mp-drop {
    from { opacity: 0; translate: 0 -60px; rotate: 10deg; }
  }

  /* cinta */
  .mp-cinta {
    background: var(--verde);
    color: #f5efe6;
    overflow: hidden;
    transform: rotate(-1.5deg);
    margin: 24px -10px;
  }
  .mp-cinta-in {
    display: flex;
    width: max-content;
    padding: 14px 0 10px;
    font-family: "Bebas Neue", sans-serif;
    font-size: 34px;
    letter-spacing: 0.02em;
    animation: mp-cinta 30s linear infinite;
  }
  .mp-cinta-in span::after {
    content: "/";
    margin: 0 28px;
    opacity: 0.6;
  }
  .mp-cinta a {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  @keyframes mp-cinta {
    to { transform: translateX(-50%); }
  }

  /* sabores */
  .mp-sabores {
    max-width: 1240px;
    margin: 0 auto;
    padding: 64px 16px 32px;
  }
  .mp-sab-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px 40px;
    margin-bottom: 40px;
  }
  .mp-h2 {
    font-size: clamp(56px, 9vw, 120px);
  }
  .mp-scr {
    font-family: "Yellowtail", cursive;
    font-size: clamp(30px, 3.4vw, 46px);
    line-height: 1.05;
    color: var(--verde);
    max-width: 14ch;
    rotate: -4deg;
  }
  .mp-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px 16px;
  }
  .mp-card {
    rotate: var(--r);
    transition: rotate 0.3s, translate 0.3s, opacity 0.7s, transform 0.7s;
  }
  .mp-card:hover {
    rotate: 0deg;
    translate: 0 -6px;
  }
  .mp-card-img {
    background: #fff;
    padding: 8px 8px 0;
    box-shadow: 0 14px 30px rgba(17, 17, 17, 0.14);
    overflow: hidden;
  }
  .mp-card-img img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    display: block;
    transition: scale 0.5s;
  }
  .mp-card:hover .mp-card-img img {
    scale: 1.06;
  }
  .mp-card p {
    background: #fff;
    padding: 10px 10px 12px;
    font-family: "Bebas Neue", sans-serif;
    font-size: 21px;
    line-height: 1;
    box-shadow: 0 14px 30px rgba(17, 17, 17, 0.14);
  }
  .mp-card p span {
    color: var(--verde);
    margin-right: 8px;
  }

  /* pilares */
  .mp-pilares {
    max-width: 1240px;
    margin: 0 auto;
    padding: 56px 16px 72px;
  }
  .mp-pilares ol {
    list-style: none;
    margin: 0;
    padding: 28px 0 0;
    display: grid;
    gap: 28px;
    border-top: 2px solid #111;
  }
  .mp-pilares span {
    display: block;
    color: var(--verde);
    font-weight: 800;
    font-size: 12px;
    letter-spacing: 0.16em;
  }
  .mp-pilares b {
    display: block;
    margin: 6px 0 8px;
    font-family: "Bebas Neue", sans-serif;
    font-weight: 400;
    font-size: 44px;
    line-height: 0.9;
    text-transform: uppercase;
  }
  .mp-pilares p {
    font-size: 15px;
    line-height: 1.6;
    color: #3a352e;
    max-width: 34ch;
  }

  /* showcase: fotos a pantalla completa que se tapan una a otra */
  .mp-show {
    position: relative;
    height: 500svh;
    background: #111;
  }
  .mp-show-stick {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
  }
  .mp-show-it {
    --dim: 0;
    position: absolute;
    inset: 0;
    margin: 0;
    overflow: hidden;
    background: #111;
    transform-origin: 50% 0;
    will-change: transform;
  }
  .mp-show-it:not(:first-child) {
    transform: translate3d(0, 100%, 0);
    box-shadow: 0 -24px 48px rgba(0, 0, 0, 0.45);
  }
  .mp-show-it::after {
    content: "";
    position: absolute;
    inset: 0;
    background: #111;
    opacity: var(--dim);
    pointer-events: none;
  }
  .mp-show-it img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    will-change: transform;
  }
  .mp-show-ui {
    position: absolute;
    z-index: 20;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    padding: 22vh 6vw 9vh;
    background: linear-gradient(rgba(0, 0, 0, 0), rgba(0, 0, 0, 0.72));
    pointer-events: none;
  }
  .mp-show-logo {
    width: min(46vw, 340px);
    filter: drop-shadow(0 4px 14px rgba(0, 0, 0, 0.4));
  }
  .mp-show-n {
