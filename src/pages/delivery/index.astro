---
import Layout from "../../layouts/Layout.astro";
import Migas from "../../components/Migas.astro";
import CtaPedir from "../../components/CtaPedir.astro";
import { COMUNAS_DELIVERY, LOCAL } from "../../data/negocio";
---

<Layout
  title="Delivery en Providencia, Las Condes, Vitacura y La Reina"
  description="Cobertura de delivery de Agostina Pizzas desde Los Leones, Providencia: Providencia, Las Condes, Vitacura y La Reina. Cómo pedir y preguntas frecuentes de despacho."
>
  <div class="container cabecera-pagina">
    <Migas items={[{ label: "Delivery" }]} />
    <span class="eyebrow">Delivery</span>
    <h1 class="titulo-pagina">Santiago oriente, con la piedra todavía caliente</h1>
    <p class="copy-seccion">
      Despachamos desde {LOCAL.direccion.calle}, {LOCAL.direccion.comuna}. Las comunas priorizadas son Providencia, Las Condes,
      Vitacura y La Reina — pero la cobertura exacta de tu dirección se confirma siempre en el sistema de pedidos, donde la zona se
      valida en tiempo real antes de pagar.
    </p>
  </div>

  <section class="seccion seccion-oliva">
    <div class="container">
      <ul class="comunas-grid">
        {
          COMUNAS_DELIVERY.map((c) => (
            <li>
              <h2>{c}</h2>
              <p>Ingresa tu dirección de {c} en el sistema de pedidos para confirmar cobertura y tiempo estimado.</p>
              <CtaPedir origen={`delivery-comuna-${c.toLowerCase().replace(/\s+/g, "-")}`} texto="Pedir a esta comuna" variante="olive" tamano="sm" />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="seccion seccion-crema">
    <div class="container">
      <div class="bloque-cabecera">
        <span class="eyebrow">Cómo pedir</span>
        <h2 class="titulo-seccion">Tres pasos, sin vueltas</h2>
      </div>
      <ol class="pasos">
        <li><span>01</span><p>Elige tu pizza en la carta y toca "Pedir ahora" — te lleva al sistema de pedidos.</p></li>
        <li><span>02</span><p>Ingresa tu dirección; el sistema confirma al instante si está dentro de la zona de despacho.</p></li>
        <li><span>03</span><p>Paga y sigue el estado de tu pedido desde ahí — el pago y el despacho se gestionan en esa plataforma.</p></li>
      </ol>
    </div>
  </section>

  <section class="seccion seccion-crema-2">
    <div class="container">
      <div class="bloque-cabecera">
        <span class="eyebrow">Preguntas frecuentes</span>
        <h2 class="titulo-seccion">Sobre el despacho</h2>
      </div>
      <div class="faq">
        <details>
          <summary>¿En qué comunas entrega Agostina?</summary>
          <p>Las comunas priorizadas son {COMUNAS_DELIVERY.join(", ")}. La cobertura exacta de una dirección puntual se confirma en el sistema de pedidos.</p>
        </details>
        <details>
          <summary>¿Cómo sé si llegan a mi dirección?</summary>
          <p>Ingresa tu dirección completa en el sistema de pedidos antes de pagar: te confirma de inmediato si está dentro de la zona de despacho vigente.</p>
        </details>
        <details>
          <summary>¿Puedo retirar en el local en vez de pedir delivery?</summary>
          <p>El local está en {LOCAL.direccion.calle}, {LOCAL.direccion.comuna} — revisa <a href="/como-llegar/">Cómo llegar</a> para la dirección y el mapa.</p>
        </details>
      </div>
    </div>
  </section>

  <section class="seccion seccion-negra cta-cierre">
    <div class="container">
      <h2 class="titulo-seccion">Confirma tu cobertura y pide</h2>
      <CtaPedir origen="delivery-cierre" texto="Pedir ahora" variante="ghost-light" />
    </div>
  </section>
</Layout>

<style>
  .cabecera-pagina {
    padding-top: 140px;
    padding-bottom: var(--space-5);
  }
  .titulo-pagina {
    font-size: clamp(48px, 8.4vw, 112px);
    line-height: 0.9;
    margin: var(--space-2) 0 var(--space-3);
    max-width: 22ch;
  }
  .comunas-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }
  @media (min-width: 700px) {
    .comunas-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1080px) {
    .comunas-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .comunas-grid li {
    background: rgba(245, 239, 230, 0.07);
    border: 1px solid rgba(245, 239, 230, 0.18);
    border-radius: var(--radius);
    padding: var(--space-3);
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: flex-start;
  }
  .comunas-grid h2 {
    font-size: 26px;
  }
  .comunas-grid p {
    font-size: 13px;
    line-height: 1.55;
    color: rgba(245, 239, 230, 0.8);
    font-weight: 500;
  }
  .bloque-cabecera {
    max-width: 700px;
    margin-bottom: var(--space-5);
  }
  .pasos {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    counter-reset: paso;
    max-width: 700px;
  }
  .pasos li {
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
    border-bottom: 1px solid var(--border);
    padding-bottom: var(--space-3);
  }
  .pasos li:last-child {
    border-bottom: none;
  }
  .pasos span {
    font-family: var(--font-display);
    font-size: 30px;
    color: var(--color-rojo);
    flex: none;
    min-width: 50px;
  }
  .pasos p {
    font-size: 15px;
    line-height: 1.6;
    color: var(--fg-muted);
  }
  .faq {
    display: flex;
    flex-direction: column;
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    max-width: 820px;
  }
  .faq details {
    background: var(--color-crema);
    padding: 20px 24px;
  }
  .faq summary {
    cursor: pointer;
    font-weight: 700;
    font-size: 15.5px;
  }
  .faq p {
    margin-top: 12px;
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--fg-muted);
  }
  .faq a {
    text-decoration: underline;
  }
  .cta-cierre .container {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }
</style>
